{
    "name": "nixon",
    "version": "0.3.1",
    "private": true,
    "packageManager": "pnpm@11.0.0",
    "engines": {
        "node": ">=20 <21",
        "pnpm": ">=11"
    },
    "scripts": {
        "dev": "next dev -p 3118",
        "build": "next build",
        "export": "next export",
        "start": "next start -p 3118",
        "tauri": "tauri",
        "pretauri:dev": "sh -c 'ls src-tauri/binaries/llama-helper-* >/dev/null 2>&1 || { echo \"[nixon] Missing sidecar src-tauri/binaries/llama-helper-* — a bare tauri:dev cannot build it. Run ./dev-nixon.sh (dev) or ./build-gpu.sh (prod) first; they build llama-helper and copy it here. See CLAUDE.md sidecar note.\" >&2; exit 1; }'",
        "pretauri:build": "sh -c 'ls src-tauri/binaries/llama-helper-* >/dev/null 2>&1 || { echo \"[nixon] Missing sidecar src-tauri/binaries/llama-helper-* — a bare tauri:build cannot build it. Run ./build-gpu.sh first; it builds llama-helper and copies it here. See CLAUDE.md sidecar note.\" >&2; exit 1; }'",
        "tauri:dev": "node scripts/tauri-auto.js dev",
        "tauri:build": "node scripts/tauri-auto.js build",
        "tauri:dev:cpu": "tauri dev",
        "tauri:dev:metal": "tauri dev -- --features metal",
        "tauri:dev:coreml": "tauri dev -- --features coreml",
        "tauri:build:cpu": "tauri build",
        "tauri:build:metal": "tauri build -- --features metal",
        "tauri:build:coreml": "tauri build -- --features coreml",
        "lint": "next lint",
        "test": "vitest run",
        "test:watch": "vitest",
        "shots:mock": "node scripts/shots/build-mock.mjs",
        "shots": "node scripts/shots/run.mjs",
        "shots:real": "node scripts/shots/real.mjs",
        "shots:diff": "node scripts/shots/diff.mjs"
    },
    "dependencies": {
        "@blocknote/core": "0.36.0",
        "@blocknote/react": "0.36.0",
        "@blocknote/shadcn": "0.36.0",
        "@heroicons/react": "^2.2.0",
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.14",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.7",
        "@radix-ui/react-popover": "^1.1.15",
        "@radix-ui/react-progress": "^1.1.8",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.2.5",
        "@radix-ui/react-separator": "^1.1.7",
        "@radix-ui/react-slot": "^1.2.3",
        "@radix-ui/react-switch": "^1.2.5",
        "@radix-ui/react-tabs": "^1.1.12",
        "@radix-ui/react-tooltip": "^1.2.8",
        "@tanstack/react-virtual": "^3.13.13",
        "@tauri-apps/api": "^2.6.0",
        "@tauri-apps/plugin-fs": "^2.4.0",
        "@tauri-apps/plugin-notification": "~2.3.1",
        "@tauri-apps/plugin-os": "^2.3.2",
        "@tauri-apps/plugin-store": "^2.4.0",
        "@tiptap/pm": "^2.10.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.1.1",
        "date-fns": "^4.1.0",
        "framer-motion": "^11.15.0",
        "lucide-react": "^0.469.0",
        "next": "^14.2.25",
        "radix-ui": "^1.4.3",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-hook-form": "^7.59.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.3.1",
        "tailwindcss-animate": "^1.0.7",
        "zod": "^3.25.71"
    },
    "devDependencies": {
        "@tailwindcss/typography": "^0.5.15",
        "@tauri-apps/cli": "^2.1.0",
        "@tauri-apps/plugin-fs": "~2.4.0",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^20",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.7.0",
        "autoprefixer": "^10.0.1",
        "concurrently": "^8.2.2",
        "eslint": "^8.57.1",
        "eslint-config-next": "14.2.25",
        "jsdom": "^25.0.1",
        "pixelmatch": "7.2.0",
        "pngjs": "7.0.0",
        "postcss": "^8",
        "puppeteer-core": "^25.2.1",
        "tailwindcss": "^3.4.1",
        "typescript": "^5.7.2",
        "vitest": "^2.1.9",
        "wait-on": "^7.2.0"
    }
}
