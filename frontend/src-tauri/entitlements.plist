<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.device.audio-output</key>
    <true/>
    <key>com.apple.security.device.microphone</key>
    <true/>
    <key>com.apple.security.device.screen-capture</key>
    <true/>
    <key>com.apple.security.personal-information.calendars</key>
    <true/>
    <!-- Load the bundled sherpa-onnx diarization dylibs under the hardened
         runtime (specs/0010, ADR-0005). Without this, library validation
         rejects @rpath/libsherpa-onnx-c-api.dylib + libonnxruntime.1.17.1.dylib
         (adhoc-signed, no Team ID) with a "different Team IDs" dyld error. The
         dylibs are bundled by us and shipped inside the .app, so disabling
         library validation here is safe and is the standard approach for
         third-party dylibs (cf. Electron/Tauri apps). -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>